<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:noNamespaceSchemaLocation='https://monkeymanboy.github.io/BSML-Docs/BSMLSchema.xsd'>

  <!-- The gameplay setup tab area is roughly 90x46 units. Everything is
       pinned to the TOP of that box (child-align) so the content can never
       spill above/below the panel; the list height is re-measured against
       the real tab height at runtime (see SnipeFeedView.ResizeListToTab). -->
  <vertical id='root'
            child-control-width='true' child-control-height='true'
            child-expand-width='false' child-expand-height='false'
            child-align='UpperCenter' spacing='0.5'>

    <!-- Following / My Profile switch, and the My Profile sort direction
         (hidden on Following). -->
    <horizontal pref-width='88' pref-height='6' spacing='1'
                child-control-width='true' child-control-height='true'
                child-expand-width='false' child-align='MiddleCenter'>
      <button text='Following' on-click='show-following' pref-width='24' pref-height='6'/>
      <button text='My Profile' on-click='show-profile' pref-width='24' pref-height='6'/>
      <button id='order-button' text='' on-click='toggle-order' pref-width='28' pref-height='6'/>
    </horizontal>

    <!-- Player filter (sort on My Profile), scores to pull, refresh.
         The dropdown and increment controls are compacted in code
         (PostParse) because the stock prefabs assume a 90-wide row. -->
    <horizontal pref-width='88' pref-height='8' spacing='1'
                child-control-width='true' child-control-height='true'
                child-expand-width='false' child-align='MiddleLeft'>
      <dropdown-list-setting id='player-filter' text='' pref-width='36'
                             hover-hint='Show scores from one player'
                             options='filter-options' value='selected-filter'
                             apply-on-change='true'/>
      <increment-setting id='feed-count-setting' text='' pref-width='28'
                         hover-hint='How many scores to load (10-100)'
                         value='feed-count' integer-only='true'
                         min='10' max='100' increment='10'
                         apply-on-change='true'/>
      <button text='Refresh' on-click='refresh'/>
    </horizontal>

    <!-- Secondary info line, two lines on My Profile: small and muted so
         the score rows stay the visual focus. The wrapper pins the width
         so long messages wrap instead of stretching the whole tab. -->
    <horizontal pref-width='88' min-height='6.5'
                child-control-width='true' child-control-height='true'
                child-expand-width='true'>
      <text id='status' text='' font-size='2.4' color='#9EAEC2'
            align='Center' word-wrapping='true'/>
    </horizontal>

    <!-- BeatLeader-style rows: rank, cover, song line over
         avatar + player + stats + time, skill triangle, chevron. Widths add
         up to the 86-unit list (pad 1+1, four 1.5 gaps, 4.5 + 8.5 + 50 +
         7.5 + 3) so nothing gets squeezed over the cover; the text column
         takes the spare. Images are loaded by FeedRow. -->
    <custom-list id='feed-list' contents='feed-cells' select-cell='select-score'
                 cell-size='10.5' visible-cells='2.2' list-width='86'
                 clickable-cells='true' show-scrollbar='true'>
      <horizontal bg='round-rect-panel' bg-color='#00000073' pad='1' spacing='1.5'
                  vertical-fit='Unconstrained'
                  child-control-width='true' child-control-height='true'
                  child-expand-width='false' child-expand-height='false'
                  child-align='MiddleLeft'>
        <horizontal pref-width='4.5' child-control-width='true'
                    child-expand-width='true'>
          <text text='~rank-text' font-size='3' align='Center'
                word-wrapping='false'/>
        </horizontal>
        <image id='cover-image' pref-width='8.5' pref-height='8.5'
               min-width='8.5' min-height='8.5' preserve-aspect='true'/>
        <!-- horizontal-fit: the column's own fitter would otherwise resize
             it after the row lays it out and push it over the cover. -->
        <vertical spacing='0' pref-width='50' flexible-width='1000'
                  horizontal-fit='Unconstrained'
                  child-control-width='true' child-control-height='true'
                  child-expand-width='false' child-expand-height='false'>
          <!-- NO overflow-mode on the title: TMP's Ellipsis/Truncate modes
               also cull VERTICALLY - a line even slightly taller than its
               rect renders as nothing at all (the Quest mod shipped this
               exact bug once, and this font's line height runs much taller
               than the font size). FeedRow shrinks long titles to fit, and
               RectMask2Ds on these wrappers hard-clip whatever still
               doesn't. -->
          <horizontal id='song-line' pref-height='4.6' min-height='4.6'
                      child-control-width='true' child-control-height='true'
                      child-expand-width='true' child-expand-height='true'>
            <text id='title-text' text='~song-text' font-size='3.4' align='MidlineLeft'
                  word-wrapping='false'/>
          </horizontal>
          <horizontal id='info-line' spacing='1.5' pref-height='3.9' min-height='3.9'
                      child-control-width='true' child-control-height='true'
                      child-expand-width='false' child-expand-height='false'
                      child-align='MiddleLeft'>
            <image id='avatar-image' pref-width='3.5' pref-height='3.5'
                   min-width='3.5' preserve-aspect='true'/>
            <text text='~player-text' font-size='2.8' align='MidlineLeft'
                  word-wrapping='false'/>
            <text text='~stats-text' font-size='2.6' align='MidlineLeft'
                  word-wrapping='false'/>
            <text text='~time-text' font-size='2.4' color='#8899AA'
                  align='MidlineLeft' word-wrapping='false'/>
          </horizontal>
        </vertical>
        <image id='triangle-image' pref-width='7.5' pref-height='7.5'
               min-width='7.5' min-height='7.5' preserve-aspect='true'/>
        <!-- Moved onto the triangle's corners by FeedRow. -->
        <text id='tech-label' text='' font-size='1.7' color='#FF6B6B' word-wrapping='false'/>
        <text id='acc-label' text='' font-size='1.7' color='#5AA9FF' word-wrapping='false'/>
        <text id='pass-label' text='' font-size='1.7' color='#57D68D' word-wrapping='false'/>
        <text text='&gt;' font-size='4' color='#5A6B7A' align='Center'
              word-wrapping='false' pref-width='3'/>
        <horizontal tags='hovered' active='false' ignore-layout='true'
                    vertical-fit='Unconstrained'
                    bg='round-rect-panel' bg-color='#FFFFFF12'/>
      </horizontal>
    </custom-list>
  </vertical>

  <!-- Detail modal, BeatLeader style: cover with the skill triangle under
       it next to the song text, avatar + player row, then the play button.
       The text wrapper has a fixed width (76 - 2x2 pad - 16 cover - 2 gap)
       so long lines wrap instead of pushing the cover and name out. -->
  <modal id='detail-modal' size-delta='76 58' click-off-closes='true'>
    <vertical pad='2' spacing='1'
              horizontal-fit='Unconstrained' vertical-fit='Unconstrained'
              child-control-width='true' child-control-height='true'
              child-expand-width='true' child-expand-height='false'>
      <horizontal spacing='2' child-control-width='true'
                  child-control-height='true' child-expand-width='false'
                  child-align='UpperLeft'>
        <!-- spacing and pad-bottom leave room for the two-line corner
             labels above and below the triangle. -->
        <vertical pref-width='16' spacing='3.5' pad-bottom='4'
                  horizontal-fit='Unconstrained' vertical-fit='Unconstrained'
                  child-control-width='true' child-control-height='true'
                  child-expand-width='false' child-expand-height='false'
                  child-align='UpperCenter'>
          <image id='modal-cover' pref-width='16' pref-height='16'
                 min-width='16' min-height='16' preserve-aspect='true'/>
          <image id='modal-triangle' pref-width='14' pref-height='14'
                 preserve-aspect='true'/>
          <text id='modal-tech-label' text='' font-size='2.2' color='#FF6B6B' word-wrapping='false'/>
          <text id='modal-acc-label' text='' font-size='2.2' color='#5AA9FF' word-wrapping='false'/>
          <text id='modal-pass-label' text='' font-size='2.2' color='#57D68D' word-wrapping='false'/>
        </vertical>
        <horizontal pref-width='54' child-control-width='true'
                    child-control-height='true' child-expand-width='true'>
          <text id='modal-detail' text='' font-size='3' align='TopLeft'
                word-wrapping='true'/>
        </horizontal>
      </horizontal>
      <horizontal spacing='1.5' child-control-width='true'
                  child-control-height='true' child-expand-width='false'>
        <image id='modal-avatar' pref-width='4' pref-height='4'
               min-width='4' min-height='4' preserve-aspect='true'/>
        <text id='modal-player' text='' font-size='3' align='MidlineLeft'/>
      </horizontal>
      <button id='play-button' text='Play' on-click='play-selected'/>
    </vertical>
  </modal>
</bg>

{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "SnipeFeed",
    "id": "snipefeed",
    "version": "3.4.0",
    "url": null,
    "additionalData": {
      "overrideSoName": "libsnipefeed.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1 $0:?"
      ],
      "clean": [
        "pwsh ./scripts/build.ps1 -clean"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1 $0:?"
      ],
      "log": [
        "pwsh ./scripts/start-logging.ps1 $0:?"
      ],
      "qmod": [
        "pwsh ./scripts/createqmod.ps1 $0:?"
      ],
      "restart": [
        "pwsh ./scripts/restart-game.ps1 $0:?"
      ],
      "stack": [
        "pwsh ./scripts/ndk-stack.ps1 $0:?"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1 $0:?"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "./SnipeFeed.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.4.3",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false,
        "private": true
      }
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4503.0.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "reflectcpp",
      "versionRange": "^0.25.0",
      "additionalData": {}
    },
    {
      "id": "libcurl",
      "versionRange": "=8.5.0",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.5",
      "additionalData": {}
    },
    {
      "id": "songcore",
      "versionRange": "^1.3.5",
      "additionalData": {}
    }
  ]
}
